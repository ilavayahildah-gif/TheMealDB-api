// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Uses your .env file
}

model User {
  id         Int      @id @default(autoincrement())
  first_name String
  last_name  String
  email      String   @unique
  password   String
  created_at DateTime @default(now())

  // Relation: one user → many meals
  meals   Meal[]
  recipes Recipe[]
  orders  Order[]
}

model Meal {
  id         Int      @id @default(autoincrement())
  name       String
  calories   Int?
  notes      String?
  stock      Int      @default(20) //default meal stock
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  user_id    Int
  supplierId String?
  bestBefore DateTime
  verified   Boolean  @default(false)

  //relation back to user
  user     User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders   Order[]
  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

model Recipe {
  id           Int      @id @default(autoincrement())
  userId       Int
  name         String
  description  String
  ingredients  String
  instructions String
  stock        Int      @default(15) //default recipe stock
  created_at   DateTime @default(now())
  bestBefore   DateTime

  //relation back to user
  user  User    @relation(fields: [userId], references: [id])
  order Order[]
}

model Order {
  id         Int      @id @default(autoincrement())
  userId     Int
  mealId     Int? // optional - if it's a meal order
  recipeId   Int? // optional - if it's a recipe order
  quantity   Int
  totalPrice Float
  status     String   @default("pending")
  created_at DateTime @default(now())

  //relations
  user   User    @relation(fields: [userId], references: [id])
  meal   Meal?   @relation(fields: [mealId], references: [id])
  recipe Recipe? @relation(fields: [recipeId], references: [id])
}

model Supplier {
  id    String  @id @default(uuid())
  name  String
  email String  @unique
  phone String?
  meals Meal[]
}
